{
  "name": "quick-rag",
  "version": "2.3.0",
  "description": "Production-ready RAG (Retrieval-Augmented Generation) for JavaScript & React - Built on official Ollama & LM Studio SDKs with Hybrid Search, Reranking, Query Transformation, Caching, Conversation Management & Evaluation",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "node": "./src/index.node.js",
      "browser": "./src/index.browser.js",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react/index.d.ts",
      "default": "./src/react/index.js"
    }
  },
  "keywords": [
    "rag",
    "ollama",
    "lmstudio",
    "vector-store",
    "embeddings",
    "retrieval",
    "ai",
    "llm",
    "react",
    "local-ai",
    "vector-search",
    "retrieval-augmented-generation",
    "pdf",
    "document-loader",
    "pdf-parser",
    "word",
    "excel",
    "decision-engine",
    "query-explainability",
    "prompt-management",
    "streaming",
    "typescript",
    "semantic-search",
    "chatbot",
    "knowledge-base",
    "bm25",
    "hybrid-search",
    "reranking",
    "query-expansion",
    "reciprocal-rank-fusion",
    "caching",
    "conversation-manager",
    "rag-evaluation",
    "chromadb",
    "qdrant",
    "vector-database"
  ],
  "scripts": {
    "test": "node test/run-tests.js",
    "test:integration": "node test/run-integration.js",
    "build": "node build.js",
    "prepublishOnly": "npm run build && npm test",
    "version": "npm run build"
  },
  "author": "Cihat Emre Karataş",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emredeveloper/quick-rag.git"
  },
  "homepage": "https://github.com/emredeveloper/quick-rag#readme",
  "bugs": {
    "url": "https://github.com/emredeveloper/quick-rag/issues"
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lmstudio/sdk": "^1.5.0",
    "ollama": "^0.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0",
    "chromadb": "^1.9.0",
    "@qdrant/js-client-rest": "^1.12.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.11.0",
    "node-fetch": "^3.3.2",
    "officeparser": "^5.2.1",
    "pdf-parse": "^1.1.4",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  }
}
